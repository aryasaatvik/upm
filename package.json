{
  "name": "@aryasaatvik/upm",
  "version": "0.0.0",
  "description": "A fast, tiny package manager for the npm registry, written in TypeScript.",
  "license": "MIT",
  "repository": "aryasaatvik/upm",
  "bin": {
    "upm": "./dist/upm.mjs",
    "upx": "./dist/upx.mjs"
  },
  "workspaces": [
    "web"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./resolver": "./dist/resolver.mjs",
    "./worker": "./dist/worker/worker.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild",
    "deps": "node ./upm install",
    "dev": "vitest dev",
    "fmt": "automd && oxlint . --fix && oxfmt .",
    "lint": "oxlint . && oxfmt --check .",
    "web": "node ./upm run -w web dev",
    "prepack": "npm run build",
    "test": "npm run lint && npm run typecheck && vitest run --coverage",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "tegami": "node scripts/tegami.mts",
    "release:check": "npm run lint && npm run typecheck && vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/worker-bundler": "^0.2.4",
    "@types/node": "latest",
    "@vitest/coverage-v8": "^4.1.0",
    "automd": "latest",
    "jup": "latest",
    "obuild": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "tegami": "^1.5.0",
    "typescript": "latest",
    "vitest": "^4.1.0",
    "workerd": "1.20260928.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "upm",
      "version": "^1",
      "onFail": "warn"
    }
  }
}
